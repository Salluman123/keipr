EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_RC_API_KEY=appl_your-revenuecat-ios-api-key

# DO NOT put the Anthropic key here — it is handled server-side via the
# Supabase Edge Function (supabase/functions/scan-receipt).
# Set it as a Supabase secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# RevenueCat webhook secrets are also server-only:
#   supabase secrets set REVENUECAT_WEBHOOK_SECRET=your-random-secret
#   supabase secrets set REVENUECAT_ENTITLEMENT_ID="get.keipr Pro"
